{
  "name": "roll-the-world-guide",
  "version": "2.0.0",
  "private": true,
  "description": "Reusable source-tracked game guide framework with locale-aware routing.",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run prepare:routes && next dev",
    "build": "npm run prepare:routes && node scripts/deployment-marker.mjs && next build --webpack",
    "start": "node scripts/serve-static.mjs",
    "build:video-transcripts": "node scripts/build-video-transcripts.mjs",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "lint": "node scripts/check-lint.mjs",
    "check:brand-icons": "node scripts/check-brand-icons.mjs",
    "test:contracts": "node scripts/check-contract-tests.mjs",
    "typecheck": "npm run prepare:routes && next typegen && tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:video-evidence": "node scripts/check-video-evidence.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "verify": "npm run lint && npm run test:contracts && npm run test:routes && npm run test:generator && npm run check:brand-icons && npm run typecheck && npm run check:content && npm run check:video-evidence && npm run check:reading && npm run check:architecture && npm run build && npm run check:export && npm run check:build && npm run check:architecture-build && npm run check:links && npm run check:seo && npm run check:homepage && npm run check:ads",
    "check:reading": "node scripts/check-reading-content.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "create:site": "node scripts/create-site.mjs",
    "check:architecture-build": "node scripts/check-architecture-build.mjs",
    "prepare:routes": "node scripts/prepare-routes.mjs",
    "check:export": "node scripts/check-export.mjs",
    "test:routes": "node scripts/check-route-preparation.mjs",
    "test:generator": "node scripts/check-generator.mjs",
    "check:homepage": "node scripts/check-homepage.mjs",
    "check:ads": "node scripts/check-ads.mjs"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
